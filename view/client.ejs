<!DOCTYPE html>
<html>

<head>
    <title>2004Scape Game</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7">

    <style>
        body,
        td,
        p {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
            margin: 0;
        }

        body {
            background-color: black;
            overflow: auto;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            outline: none;
            image-rendering: pixelated;
            margin: 0 auto;
        }

        /* Navbar styling */
        #navbar {
            width: 765px;
            height: 25px;
            margin: 0 auto;
            position: relative;
            background: url('client/navbar.gif') no-repeat;
        }

        #navbar a {
            display: inline-flex;
            align-items: center;
            margin-left: 5px;
            height: 25px;
            text-decoration: none;
            color: white;
            font-size: 11px;
        }

        #navbar a:hover {
            color: #04A800;
            text-decoration: underline;
        }

        #navbar img {
            vertical-align: middle;
            margin-right: 2px;
        }

        /* Controls styling */
        #controls {
            margin-top: 3px;
            margin-bottom: 10px;
            text-align: center;
        }

        select {
            background-color: black;
            color: #04A800;
            border: none;
        }

        select option {
            background-color: black;
            color: #04A800;
        }

        select option:hover {
            background-color: #222;
            color: #04A800;
        }

        #mobilekeyboard-container {
            display: none;
        }
    </style>
</head>

<body>
    <center>
        <!-- Navbar -->
        <div id="navbar">
            <!-- Jagex logo -->
            <img src="client/navbar_singleplayer.gif" height="25" alt="singleplayerLogo">

            <!-- Menu links with local GIFs -->
            <a href="title.ws" id="menulink">
                <img src="client/navbar_mainmenu.gif" height="16" alt="Main Menu">
                Main Menu
            </a>
            <a href="serverlist.ws?lores.x=1&plugin=0" id="menulink2">
                <img src="client/navbar_mainmenu.gif" height="16" alt="World Select">
                World Select
            </a>
            <a href="worldmap/popupworldmap.ws" target="WorldMap">
                <img src="client/navbar_worldmap.gif" height="16" alt="World Map">
                World Map
            </a>
            <a href="howtoplay.ws" target="Manual">
                <img src="client/navbar_manual.gif" height="16" alt="Manual">
                Manual
            </a>
            <a href="guides/rules.ws" target="RulesSecurity">
                <img src="client/navbar_rules.gif" height="16" alt="Rules & Security">
                Rules & Security
            </a>
            <a href="members/members.ws" target="UpgradetoMembers">
                <img src="client/navbar_members.gif" height="16" alt="Upgrade to Members">
                Upgrade to Members
            </a>
        </div>

        <!-- Game canvas -->
        <div id="game">
            <canvas id="canvas" width="765" height="503">
                Your browser cannot run our web client.
            </canvas>
        </div>

        <!-- Controls (UNCHANGED) -->
        <div id="controls">
            <select id="size" name="size" onchange="setSize();">
                <option value="1" id="1">1x Size</option>
                <option value="2" id="2">2x Size</option>
                <option value="3" id="3">3x Size</option>
                <option value="auto" id="auto">Auto Sizing</option>
            </select> |
            <select id="filtering" name="filtering" onchange="setFilter('dropdown');">
                <option value="auto" id="auto">Auto Scaling</option>
                <option value="pixelated" id="pixelated">Pixel Scaling</option>
            </select> |
            <span id="mobilekeyboard-container">
                <select id="mobilekeyboard" name="mobilekeyboard" onchange="setKeyboardChoice();">
                    <option value="hybrid" id="hybrid">Hybrid keyboard</option>
                    <option value="canvas" id="canvas">Canvas keyboard</option>
                    <option value="native" id="native">Native keyboard</option>
                </select> |
            </span>
            <a class="green" href="#" id="fullscreen" onclick="toggleFullscreen();">Go Fullscreen</a> |
            <a class="green" href="#" id="screenshot" onclick="saveScreenshot();">Take screenshot</a> |
            <a class="green" href="#" id="hide" onclick="hideControls();">Hide controls</a>
        </div>
        <div id="hide-message" style="display: none;">
            <p class="green blink">Controls have been hidden press ctrl+alt+i to unhide.</p>
            <p class="green" id="count-down"></p>
        </div>
    </center>

    <script type="module">
        import { Client } from './client/client.js';
        (() => { new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>); })();
        loadSettings();
    </script>
</body>
</html>
