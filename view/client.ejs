<!DOCTYPE html>
<html>

<head>
    <title>2004Scape Game</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7">

    <style>
        body {
            margin: 0;
            overflow: auto;
            background-color: black;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
        }

        #game {
            margin: 0 auto;
            display: block;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            outline: none;
            image-rendering: pixelated;
        }

        /* Navbar styling */
        #navbar-container {
            width: 765px;
            margin: 0 auto;
            position: relative;
            height: 25px;
            background: url('navbar.gif') no-repeat;
        }

        #navbar-container a {
            display: inline-flex;
            align-items: center;
            margin-left: 5px;
            height: 25px;
            text-decoration: none;
            color: white;
            font-size: 12px;
        }

        #navbar-container a:hover {
            color: #04A800;
            text-decoration: underline;
        }

        #navbar-container img {
            vertical-align: middle;
            margin-right: 2px;
        }

        /* Controls styling */
        #controls {
            margin-top: 3px;
            margin-bottom: 10px;
            text-align: center;
        }

        select {
            background-color: black;
            color: #04A800;
            border: none;
        }

        select option {
            background-color: black;
            color: #04A800;
        }

        select option:hover {
            background-color: #222;
            color: #04A800;
        }

        #mobilekeyboard-container {
            display: none;
        }
    </style>

    <script>
        // All original JS preserved
        function toggleFullscreen() {
            let el = document.getElementById('canvas');
            if (!document.fullscreenElement) el.requestFullscreen();
            else document.exitFullscreen();
        }

        function saveScreenshot() {
            let link = document.getElementById('screenshot');
            link.download = 'screenshot-' + Math.floor(Date.now() / 1000) + '.png';
            link.href = document.getElementById('canvas').toDataURL('image/png').replace(/^data:image\/[^;]/, 'data:application/octet-stream');
        }

        function setSize(size) {
            let canvas = document.getElementById('canvas');
            if (!size) size = document.getElementById('size').value;
            switch(size) {
                case '1': case '2': case '3':
                    canvas.style.width = (765 * parseInt(size)) + 'px';
                    canvas.style.height = (503 * parseInt(size)) + 'px';
                    break;
                case 'auto':
                    canvas.style.width = '100%';
                    canvas.style.height = 'auto';
                    break;
            }
            localStorage.setItem('canvasSize', size);
        }

        function setFilter(type) {
            let canvas = document.getElementById('canvas');
            let filterSelect = type || document.getElementById('filtering').value;
            canvas.style.imageRendering = filterSelect;
            if (type === 'dropdown') localStorage.setItem('filtering', filterSelect == 'auto' ? false : true);
            else document.getElementById('filtering').value = filterSelect;
        }

        function loadSettings() {
            setFilter((localStorage.getItem('filtering')=='true') ? 'pixelated' : 'auto');
            let size = localStorage.getItem('canvasSize');
            if (size) setSize(size);
        }
    </script>
</head>

<body>
    <center>
        <!-- Navbar -->
        <div id="navbar-container">
            <!-- Jagex logo -->
            <img src="navbar_singleplayer.gif" height="25" alt="singleplayer">

            <!-- Menu links with individual GIFs -->
            <a href="#">
                <img src="navbar_mainmenu.gif" height="16" alt="Main Menu">
                Main Menu
            </a>
            <a href="#">
                <img src="navbar_mainmenu.gif" height="16" alt="World Select">
                World Select
            </a>
            <a href="#">
                <img src="navbar_worldmap.gif" height="16" alt="World Map">
                World Map
            </a>
            <a href="#">
                <img src="navbar_manual.gif" height="16" alt="Manual">
                Manual
            </a>
            <a href="#">
                <img src="navbar_rules.gif" height="16" alt="Rules & Security">
                Rules & Security
            </a>
            <a href="#">
                <img src="navbar_members.gif" height="16" alt="Upgrade to Members">
                Upgrade to Members
            </a>
        </div>

        <!-- Game canvas -->
        <div id="game">
            <canvas id="canvas" width="765" height="503">
                Your browser cannot run our web client.
            </canvas>
        </div>

        <!-- Controls -->
        <div id="controls">
            <select id="size" onchange="setSize();">
                <option value="1">1x Size</option>
                <option value="2">2x Size</option>
                <option value="3">3x Size</option>
                <option value="auto">Auto</option>
            </select> |
            <select id="filtering" onchange="setFilter('dropdown');">
                <option value="auto">Auto Scaling</option>
                <option value="pixelated">Pixel Scaling</option>
            </select> |
            <span id="mobilekeyboard-container">
                <select id="mobilekeyboard" onchange="alert('Reload to apply');">
                    <option value="hybrid">Hybrid</option>
                    <option value="canvas">Canvas</option>
                    <option value="native">Native</option>
                </select> |
            </span>
            <a class="green" href="#" onclick="toggleFullscreen();">Go Fullscreen</a> |
            <a class="green" href="#" id="screenshot" onclick="saveScreenshot();">Take screenshot</a>
        </div>
    </center>

    <script type="module">
        import { Client } from './client/client.js';
        (() => { new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>); })();
        loadSettings();
    </script>
</body>
</html>
