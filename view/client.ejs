<!DOCTYPE html>
<html lang="en">

<head>
    <title>2004Scape Game</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7, viewport-fit=cover">

    <!-- Security: Basic CSP -->
 <meta http-equiv="Content-Security-Policy"
content="
default-src 'self';
img-src 'self' data: blob:;
script-src 'self' 'unsafe-inline';
style-src 'self' 'unsafe-inline';
connect-src 'self' ws: wss:;
">


    <style>
        html {
            touch-action: manipulation;
            overscroll-behavior: none;
            background-color: black;
        }

        body {
            margin: 0;
            overflow: auto;
            background-color: black;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-bottom: env(safe-area-inset-bottom);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
        }

        #game {
            display: block;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            outline: none;
            z-index: -1;
            image-rendering: pixelated;
            touch-action: none;
            will-change: transform;
        }

        .centered {
            text-align: center;
        }

        .green {
            text-decoration: none;
            color: #04A800;
        }

        a:focus {
            outline: 2px solid #04A800;
        }

        select {
            background-color: black;
            color: #04A800;
            border: none;
        }

        #mobilekeyboard-container {
            display: none;
        }

        .navbar-link {
            color: white;
            text-decoration: underline;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .navbar-link:hover {
            text-decoration: none;
        }

        @keyframes blink {
            50% { opacity: 0.5; }
        }

        .blink {
            animation: blink 1.5s linear infinite;
        }
    </style>

    <script>
        function isTouchDevice() {
            return ('ontouchstart' in window) ||
                (navigator.maxTouchPoints > 0) ||
                (navigator.msMaxTouchPoints > 0);
        }

        function isMobile() {
            return /Android|webOS|iPhone|iPad|iPod|BlackBerry|Windows Phone|Mobile/i.test(navigator.userAgent)
                || isTouchDevice();
        }

        function toggleFullscreen() {
            const canvas = document.getElementById('canvas');

            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                canvas.requestFullscreen();
            }
        }

        function resizeCanvasForDPI() {
            const canvas = document.getElementById('canvas');
            const ctx = canvas.getContext('2d');

            const dpr = window.devicePixelRatio || 1;
            const rect = canvas.getBoundingClientRect();

            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;

            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.scale(dpr, dpr);
        }

        function saveScreenshot() {
            const canvas = document.getElementById('canvas');
            const link = document.getElementById('screenshot');

            link.download = 'screenshot-' + Date.now() + '.png';
            link.href = canvas.toDataURL('image/png');
        }

        function setSize(size) {
            const canvas = document.getElementById('canvas');

            if (!size) size = document.getElementById('size').value;

            if (size === 'auto') {
                canvas.style.width = '100%';
                canvas.style.height = 'auto';
            } else {
                canvas.style.width = (765 * parseInt(size)) + 'px';
                canvas.style.height = (503 * parseInt(size)) + 'px';
            }

            localStorage.setItem('canvasSize', size);
            resizeCanvasForDPI();
        }

        function setFilter(type) {
            const canvas = document.getElementById('canvas');
            let filterSelect = type === 'dropdown'
                ? document.getElementById('filtering').value
                : type;

            canvas.style.imageRendering = filterSelect;
            localStorage.setItem('filtering', filterSelect === 'pixelated');
        }

        function loadSettings() {
            const filtering = localStorage.getItem('filtering') === 'true';
            setFilter(filtering ? 'pixelated' : 'auto');

            const size = localStorage.getItem('canvasSize');
            if (size) setSize(size);

            if (isMobile()) {
                document.getElementById('mobilekeyboard-container').style.display = 'inline-block';
            }
        }

        window.addEventListener('resize', resizeCanvasForDPI);
        document.addEventListener('fullscreenchange', resizeCanvasForDPI);
    </script>
</head>

<body>

    <!-- NAVBAR -->
    <table border="0" background="/client/navbar.gif" cellspacing="0" cellpadding="0"
        width="765" height="25">
        <tr>
            <td width="5"></td>
            <td><img src="/client/navbar_singleplayer.gif"></td>
            <td></td>
            <td><a href="#" class="navbar-link">Main Menu</a></td>
            <td></td>
            <td><a href="#" class="navbar-link">World Select</a></td>
            <td></td>
            <td>
                <a onclick="window.open('/client/popupworldmap.ws','WorldMap','width=635,height=550,noopener,noreferrer');return false;"
                    href="#" class="navbar-link">
                    World Map
                </a>
            </td>
            <td></td>
            <td><a href="/client/howtoplay.ws" target="_blank" class="navbar-link">Manual</a></td>
            <td></td>
            <td><a href="/client/guides/rules.ws" target="_blank" class="navbar-link">Rules & Security</a></td>
            <td></td>
            <td><a href="/client/members/members.ws" target="_blank" class="navbar-link">Upgrade to Members</a></td>
            <td width="5"></td>
        </tr>
    </table>

    <!-- GAME -->
    <div id="game">
        <canvas id="canvas" width="765" height="503" role="application"
            aria-label="2004Scape Game Client">
            Your browser does not support the game client.
        </canvas>
    </div>

    <!-- CONTROLS -->
    <div class="centered">
        <select id="size" onchange="setSize();">
            <option value="1">1x Size</option>
            <option value="2">2x Size</option>
            <option value="3">3x Size</option>
            <option value="auto">Auto Sizing</option>
        </select> |
        <select id="filtering" onchange="setFilter('dropdown');">
            <option value="auto">Auto Scaling</option>
            <option value="pixelated">Pixel Scaling</option>
        </select> |
        <span id="mobilekeyboard-container">
            <select id="mobilekeyboard">
                <option value="hybrid">Hybrid keyboard</option>
                <option value="canvas">Canvas keyboard</option>
                <option value="native">Native keyboard</option>
            </select> |
        </span>
        <a class="green" href="#" onclick="toggleFullscreen()">Go Fullscreen</a> |
        <a class="green" id="screenshot" href="#" onclick="saveScreenshot()">Take screenshot</a>
    </div>

    <!-- LOADING SCREEN -->
    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = 'black';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = 'white';
        ctx.font = 'bold 20px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Loading...', canvas.width / 2, canvas.height / 2);

        resizeCanvasForDPI();
        loadSettings();
    </script>

    <!-- GAME CLIENT -->
    <script type="module">
        import { Client } from './client/client.js';
        new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>);
    </script>

</body>
</html>
