<!DOCTYPE html>
<html>

<head>
    <title>2004Scape Game</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7">

    <style>
        html { touch-action: manipulation; }

        body, td, p {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
        }

        body {
            margin: 0;
            overflow: auto;
            background-color: black;
        }

        #rs-header {
            width: 765px;
            margin: 0 auto;
        }

        #game {
            margin-left: auto;
            margin-right: auto;
            display: block;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            -webkit-user-select: none;
            -moz-user-select: none;
            user-select: none;
            outline: none;
            image-rendering: pixelated;
        }

        .green {
            text-decoration: none;
            color: #04A800;
        }

        .centered { text-align: center; }

        #controls {
            margin-top: 3px;
            margin-bottom: 10px;
        }

        select {
            background-color: black;
            color: #04A800;
            border: none;
        }
    </style>
</head>

<body>
<center>

    <!-- ================= HEADER START ================= -->

    <div id="rs-header">

        <!-- Top Banner -->
        <div style="text-align:center;">
            <img src="banner_742x90.gif"
                 width="742"
                 height="90"
                 style="border:none;">
        </div>

        <!-- Navbar -->
        <div style="width:765px; height:25px; background:url('navbar.gif');">
            <table border="0" cellspacing="0" cellpadding="0" width="765" height="25">
                <tr>
                    <td width="5"></td>

                    <td>
                        <img src="navbar_singleplayer.gif">
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="/title.ws" id="menulink" class="green">
                            <img src="navbar_mainmenu.gif" style="vertical-align:middle;">
                            Main Menu
                        </a>
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="/serverlist.ws" id="menulink2" class="green">
                            <img src="navbar_mainmenu.gif" style="vertical-align:middle;">
                            World Select
                        </a>
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="#" onclick="window.open('/worldmap.ws','WorldMap','width=635,height=550');return false;" class="green">
                            <img src="navbar_worldmap.gif" style="vertical-align:middle;">
                            World Map
                        </a>
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="/manual.ws" class="green">
                            <img src="navbar_manual.gif" style="vertical-align:middle;">
                            Manual
                        </a>
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="/rules.ws" class="green">
                            <img src="navbar_rules.gif" style="vertical-align:middle;">
                            Rules
                        </a>
                    </td>

                    <td width="15"></td>

                    <td>
                        <a href="/members.ws" class="green">
                            <img src="navbar_members.gif" style="vertical-align:middle;">
                            Members
                        </a>
                    </td>

                    <td width="5"></td>
                </tr>
            </table>
        </div>
    </div>

    <div style="height:10px;"></div>

    <!-- ================= GAME (UNCHANGED) ================= -->

    <div id="game">
        <canvas id="canvas" width="765" height="503">
            Your browser is not capable of running our web client.
        </canvas>
    </div>

    <!-- ================= CONTROLS (UNCHANGED) ================= -->

    <div class="centered" id="controls">
        <a class="green" href="#" onclick="toggleFullscreen();">Go Fullscreen</a> |
        <a class="green" href="#" id="screenshot" onclick="saveScreenshot();">Take screenshot</a>
    </div>

</center>

<script>
    /* ================= CANVAS LOADING TEXT ================= */
    const canvas = document.getElementById('canvas');

    if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = 'black';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        ctx.fillStyle = 'white';
        ctx.font = 'bold 20px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Loading...', canvas.width / 2, canvas.height / 2);
    }

    function toggleFullscreen() {
        let element = document.getElementById('canvas');
        if (document.fullscreenElement) {
            document.exitFullscreen();
        } else {
            element.requestFullscreen();
        }
    }

    function saveScreenshot() {
        document.getElementById('screenshot').download =
            'screenshot-' + Math.floor(Date.now() / 1000) + '.png';
        document.getElementById('screenshot').href =
            document.getElementById('canvas')
            .toDataURL('image/png')
            .replace(/^data:image\/[^;]/, 'data:application/octet-stream');
    }
</script>

<script type="module">
    import { Client } from './client/client.js';
    new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>);
</script>

<!-- ================= 2006 NAVBAR HOVER + CLICK CONFIRM ================= -->
<script>
function ConfirmMenu(e) {
    if (!e) e = window.event;
    var response = window.confirm(
        "Clicking this link will exit the game and take you to the main menu.\n" +
        "Please log out of the game before exiting.\n" +
        "Click OK if you have safely logged out."
    );
    if (response) document.location.href = menulink1;
    if (e.cancelable) e.preventDefault();
    return false;
}

function ConfirmMenu2(e) {
    if (!e) e = window.event;
    var response = window.confirm(
        "Clicking this link will exit the game and take you to the world select page.\n" +
        "Please log out of the game before exiting.\n" +
        "Click OK if you have safely logged out."
    );
    if (response) document.location.href = menulink2b;
    if (e.cancelable) e.preventDefault();
    return false;
}

function initNavbar() {
    if (!document.getElementById) return;

    // Main Menu link
    let node = document.getElementById('menulink');
    if (node) {
        menulink1 = node.getAttribute('href');
        node.setAttribute('href','#');
        node.onclick = ConfirmMenu;
    }

    // World Select link
    node = document.getElementById('menulink2');
    if (node) {
        menulink2b = node.getAttribute('href');
        node.setAttribute('href','#');
        node.onclick = ConfirmMenu2;
    }

    // Hover effect for all navbar images
    let navbarImages = document.querySelectorAll('#rs-header a img');
    navbarImages.forEach(img => {
        img.style.cursor = 'pointer';
        img.addEventListener('mouseover', () => {
            img.style.opacity = '0.7';
        });
        img.addEventListener('mouseout', () => {
            img.style.opacity = '1';
        });
    });
}

// Initialize navbar on page load
window.addEventListener('load', initNavbar);
</script>

</body>
</html>
