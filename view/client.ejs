<!DOCTYPE html>
<html>
<head>
    <title>2004Scape Game</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7">
    <style>
        body, td, p {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
            margin: 0;
        }
        body {
            background-color: black;
        }

        a.nav-link {
            color: white;
            text-decoration: none;
            vertical-align: middle;
            margin-left: 5px;
            margin-right: 15px;
        }
        a.nav-link:hover {
            text-decoration: underline;
            color: white; /* stays white on hover */
        }

        #navbar {
            background: url('client/navbar.gif') no-repeat;
            height: 25px;
            line-height: 25px;
            text-align: left;
            padding-left: 5px;
            margin-bottom: -2px; /* remove slight gap */
        }

        #navbar img {
            vertical-align: middle;
        }

        #game-container {
            text-align: center;
        }

        #canvas {
            display: block;
            margin: 0 auto;
            width: 765px;
            height: 503px;
            image-rendering: pixelated;
            outline: none;
        }

        #controls {
            text-align: center;
            margin-top: 3px;
            margin-bottom: 10px;
        }

        #controls select, #controls a {
            font-size: 12px;
            margin-left: 5px;
            margin-right: 5px;
            color: #04A800;
            background-color: black;
            border: none;
            text-decoration: none;
        }

        #controls a:hover {
            color: #04A800;
            text-decoration: underline;
        }

        #hide-message {
            text-align: center;
            display: none;
        }

        @keyframes blink {
            50% { opacity: 0.5; }
        }

        .blink {
            animation: blink 1.5s linear infinite;
        }

        #mobilekeyboard-container {
            display: none;
        }
    </style>
</head>
<body onload="loadSettings();">

<center>
    <!-- TOP NAVBAR -->
    <div id="navbar">
        <img src="client/navbar_singleplayer.gif">
        <a class="nav-link" href="#" id="menulink">
            <img src="client/navbar_mainmenu.gif"> Main Menu
        </a>
        <a class="nav-link" href="#" id="menulink2">
            <img src="client/navbar_mainmenu.gif"> World Select
        </a>
        <a class="nav-link" href="#" onclick="window.open('client/worldmap.html','WorldMap','width=635,height=550'); return false;">
            <img src="client/navbar_worldmap.gif"> World Map
        </a>
        <a class="nav-link" href="client/manual.html" target="Manual">
            <img src="client/navbar_manual.gif"> Manual
        </a>
        <a class="nav-link" href="client/rules.html" target="RulesSecurity">
            <img src="client/navbar_rules.gif"> Rules & Security
        </a>
        <a class="nav-link" href="client/members.html" target="UpgradetoMembers">
            <img src="client/navbar_members.gif"> Upgrade to Members
        </a>
    </div>

    <!-- GAME CANVAS -->
    <div id="game-container">
        <canvas id="canvas" width="765" height="503">
            Your browser is not capable of running our web client.
        </canvas>
    </div>

    <!-- BOTTOM CONTROLS -->
    <div id="controls">
        <select id="size" onchange="setSize();">
            <option value="1">1x Size</option>
            <option value="2">2x Size</option>
            <option value="3">3x Size</option>
            <option value="auto">Auto Sizing</option>
        </select> |
        <select id="filtering" onchange="setFilter('dropdown');">
            <option value="auto">Auto Scaling</option>
            <option value="pixelated">Pixel Scaling</option>
        </select> |
        <span id="mobilekeyboard-container">
            <select id="mobilekeyboard" onchange="setKeyboardChoice();">
                <option value="hybrid">Hybrid keyboard</option>
                <option value="canvas">Canvas keyboard</option>
                <option value="native">Native keyboard</option>
            </select> |
        </span>
        <a href="#" onclick="toggleFullscreen();">Go Fullscreen</a> |
        <a href="#" id="screenshot" onclick="saveScreenshot();">Take screenshot</a> |
        <a href="#" onclick="hideControls();">Hide controls</a>
    </div>

    <div id="hide-message">
        <p class="blink">Controls have been hidden, press ctrl+alt+i to unhide.</p>
        <p id="count-down"></p>
    </div>
</center>

<script>
    const canvas = document.getElementById('canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        ctx.fillStyle = 'black';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = 'white';
        ctx.font = 'bold 20px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Loading...', canvas.width/2, canvas.height/2);
    }
</script>

<script type="module">
    import { Client } from './client/client.js';
    (() => { new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>); })();
</script>

<script>
    // ORIGINAL CONTROL FUNCTIONS (setSize, setFilter, toggleFullscreen...)
    function setSize(size) {
        let canvas = document.getElementById('canvas');
        if (!size) size = document.getElementById('size').value;
        switch(size){
            case '1': case '2': case '3':
                canvas.style.width = 765 * parseInt(size) + 'px';
                canvas.style.height = 503 * parseInt(size) + 'px';
                break;
            case 'auto':
                canvas.style.width = '100%';
                canvas.style.height = 'auto';
                break;
        }
        localStorage.setItem('canvasSize', size);
    }

    function setFilter(type) {
        let canvas = document.getElementById('canvas');
        let filterType = type || document.getElementById('filtering').value;
        canvas.style.imageRendering = (filterType === 'pixelated') ? 'pixelated' : 'auto';
        document.getElementById('filtering').value = filterType;
        localStorage.setItem('filtering', filterType === 'pixelated');
    }

    function toggleFullscreen() {
        let el = document.getElementById('canvas');
        if (document.fullscreenElement) document.exitFullscreen();
        else if (el.requestFullscreen) el.requestFullscreen();
    }

    function saveScreenshot() {
        let link = document.getElementById('screenshot');
        link.download = 'screenshot-' + Math.floor(Date.now()/1000) + '.png';
        link.href = canvas.toDataURL('image/png').replace(/^data:image\/[^;]/, 'data:application/octet-stream');
    }

    function hideControls() {
        document.getElementById('controls').style.display = 'none';
        document.getElementById('hide-message').style.display = '';
        localStorage.setItem('hideControls', true);
        countDown = 0; hideMessage();
    }

    function showControls() {
        clearTimeout(timer);
        document.getElementById('controls').style.display = '';
        document.getElementById('hide-message').style.display = 'none';
        localStorage.removeItem('hideControls');
    }

    let timer, countDown=0, countDownMax=10;
    function hideMessage() {
        if (countDown >= countDownMax) {
            document.getElementById('hide-message').style.display = 'none';
            return;
        }
        document.getElementById('count-down').textContent = (countDownMax - countDown) + 's';
        countDown++;
        timer = setTimeout(hideMessage,1000);
    }

    document.addEventListener('keydown', function(e){
        if ((e.ctrlKey||e.metaKey) && e.altKey && e.code==='KeyI') showControls();
    });

    function loadSettings(){
        setFilter(localStorage.getItem('filtering')==='true'?'pixelated':'auto');
        setSize(localStorage.getItem('canvasSize') || '1');
        if(localStorage.getItem('hideControls')==='true') hideControls();
    }

    function setKeyboardChoice() {
        const val = document.getElementById('mobilekeyboard').value;
        localStorage.setItem('mobileKeyboardMode', val);
        alert('Reload page to apply changes.');
    }
</script>
</body>
</html>
