<!DOCTYPE html>
<html lang="en">

<head>
    <title>2004Scape Game</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=0.7, viewport-fit=cover">

    <!-- Relaxed CSP suitable for game clients -->
    <meta http-equiv="Content-Security-Policy"
        content="default-src * data: blob: 'unsafe-inline' 'unsafe-eval';">

    <!-- Prevent favicon 404 -->
    <link rel="icon" href="data:,">

    <style>
        html {
            background-color: black;
            overscroll-behavior: none;
            touch-action: manipulation;
        }

        body {
            margin: 0;
            background-color: black;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px;
            color: white;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding-bottom: env(safe-area-inset-bottom);
        }

        #navbar-table {
            margin-bottom: 0;
        }

        #game {
            display: flex;
            justify-content: center;
        }

        canvas {
            width: 765px;
            height: 503px;
            display: block;
            image-rendering: pixelated;
            touch-action: none;
            outline: none;
        }

        .centered {
            text-align: center;
        }

        .green {
            text-decoration: none;
            color: #04A800;
        }

        .green:hover {
            text-decoration: underline;
        }

        select {
            background-color: black;
            color: #04A800;
            border: none;
            font-size: 12px;
        }

        .navbar-link {
            color: white;
            text-decoration: underline;
            font-size: 11px;
            display: inline-flex;
            align-items: center;
            gap: 3px;
        }

        .navbar-link:hover {
            text-decoration: none;
        }
    </style>

    <script>
        function toggleFullscreen() {
            const wrapper = document.getElementById('game');

            if (document.fullscreenElement) {
                document.exitFullscreen();
            } else {
                wrapper.requestFullscreen();
            }
        }

        function saveScreenshot() {
            const canvas = document.getElementById('canvas');
            const link = document.getElementById('screenshot');

            link.download = 'screenshot-' + Date.now() + '.png';
            link.href = canvas.toDataURL('image/png');
        }

        function setSize() {
            const canvas = document.getElementById('canvas');
            const size = document.getElementById('size').value;

            if (size === 'auto') {
                canvas.style.width = '100%';
                canvas.style.height = 'auto';
            } else {
                canvas.style.width = (765 * parseInt(size)) + 'px';
                canvas.style.height = (503 * parseInt(size)) + 'px';
            }

            localStorage.setItem('canvasSize', size);
        }

        function setFilter() {
            const canvas = document.getElementById('canvas');
            const value = document.getElementById('filtering').value;

            canvas.style.imageRendering = value;
            localStorage.setItem('filtering', value === 'pixelated');
        }

        function loadSettings() {
            const size = localStorage.getItem('canvasSize');
            const filtering = localStorage.getItem('filtering');

            if (size) {
                document.getElementById('size').value = size;
                setSize();
            }

            if (filtering === 'true') {
                document.getElementById('filtering').value = 'pixelated';
                setFilter();
            }
        }
    </script>
</head>

<body>

    <!-- NAVBAR -->
    <table id="navbar-table" border="0" background="/client/navbar.gif"
        cellspacing="0" cellpadding="0" width="765" height="25">
        <tr>
            <td width="5"></td>
            <td><img src="/client/navbar_singleplayer.gif"></td>
            <td></td>
            <td>
                <a href="#" class="navbar-link">
                    <img src="/client/navbar_mainmenu.gif">
                    Main Menu
                </a>
            </td>
            <td></td>
            <td>
                <a href="#" class="navbar-link">
                    <img src="/client/navbar_mainmenu.gif">
                    World Select
                </a>
            </td>
            <td></td>
            <td>
                <a onclick="window.open('/client/popupworldmap.ws','WorldMap','width=635,height=550,noopener,noreferrer');return false;"
                    href="#" class="navbar-link">
                    <img src="/client/navbar_worldmap.gif">
                    World Map
                </a>
            </td>
            <td></td>
            <td>
                <a href="/client/howtoplay.ws" target="_blank" class="navbar-link">
                    <img src="/client/navbar_manual.gif">
                    Manual
                </a>
            </td>
            <td></td>
            <td>
                <a href="/client/guides/rules.ws" target="_blank" class="navbar-link">
                    <img src="/client/navbar_rules.gif">
                    Rules & Security
                </a>
            </td>
            <td></td>
            <td>
                <a href="/client/members/members.ws" target="_blank" class="navbar-link">
                    <img src="/client/navbar_members.gif">
                    Upgrade to Members
                </a>
            </td>
            <td width="5"></td>
        </tr>
    </table>

    <!-- GAME WRAPPER -->
    <div id="game">
        <canvas id="canvas" width="765" height="503">
            Your browser does not support the game client.
        </canvas>
    </div>

    <!-- CONTROLS -->
    <div class="centered" style="margin-top: 6px; margin-bottom: 10px;">
        <select id="size" onchange="setSize()">
            <option value="1">1x Size</option>
            <option value="2">2x Size</option>
            <option value="3">3x Size</option>
            <option value="auto">Auto Sizing</option>
        </select> |
        <select id="filtering" onchange="setFilter()">
            <option value="auto">Auto Scaling</option>
            <option value="pixelated">Pixel Scaling</option>
        </select> |
        <a class="green" href="#" onclick="toggleFullscreen(); return false;">Go Fullscreen</a> |
        <a class="green" id="screenshot" href="#" onclick="saveScreenshot(); return false;">Take screenshot</a>
    </div>

    <!-- Loading screen -->
    <script>
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        ctx.fillStyle = 'black';
        ctx.fillRect(0, 0, 765, 503);

        ctx.fillStyle = 'white';
        ctx.font = 'bold 20px Arial';
        ctx.textAlign = 'center';
        ctx.fillText('Loading...', 382, 251);

        loadSettings();
    </script>

    <!-- GAME CLIENT -->
    <script type="module">
        import { Client } from './client/client.js';
        new Client(<%= nodeid %>, <%= lowmem %>, <%= members %>);
    </script>

</body>
</html>
